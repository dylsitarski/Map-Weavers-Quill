{
  "$defs": {
    "GenerateRequest": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "negativePrompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negativeprompt"
        },
        "parameters": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "steps",
              "guidance"
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "referenceImages": {
          "items": {
            "type": "string"
          },
          "title": "Referenceimages",
          "type": "array"
        },
        "requestId": {
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "requestId",
        "prompt",
        "width",
        "height"
      ],
      "title": "GenerateRequest",
      "type": "object"
    },
    "GenerationResult": {
      "additionalProperties": false,
      "properties": {
        "assetHash": {
          "title": "Assethash",
          "type": "string"
        },
        "contractVersion": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "mediaType": {
          "const": "image/png",
          "title": "Mediatype",
          "type": "string"
        },
        "providerId": {
          "title": "Providerid",
          "type": "string"
        },
        "requestId": {
          "title": "Requestid",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "requestId",
        "providerId",
        "assetHash",
        "width",
        "height",
        "mediaType"
      ],
      "title": "GenerationResult",
      "type": "object"
    },
    "InpaintRequest": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        },
        "contractVersion": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            }
          },
          "title": "Extensions",
          "type": "object"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "maskConvention": {
          "const": "white-edit-black-preserve",
          "title": "Maskconvention",
          "type": "string"
        },
        "maskRef": {
          "title": "Maskref",
          "type": "string"
        },
        "negativePrompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negativeprompt"
        },
        "parameters": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "steps",
              "guidance"
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "referenceImages": {
          "items": {
            "type": "string"
          },
          "title": "Referenceimages",
          "type": "array"
        },
        "requestId": {
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "sourceRef": {
          "title": "Sourceref",
          "type": "string"
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "requestId",
        "prompt",
        "width",
        "height",
        "sourceRef",
        "maskRef",
        "maskConvention"
      ],
      "title": "InpaintRequest",
      "type": "object"
    },
    "JsonValue": {},
    "ProviderDescriptor": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "text_to_image",
              "inpainting",
              "image_to_image",
              "reference_image",
              "control_image",
              "transparent_background",
              "seed",
              "negative_prompt",
              "maximum_dimensions",
              "asynchronous_jobs"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "contractVersion": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "local": {
          "title": "Local",
          "type": "boolean"
        },
        "maxHeight": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Maxheight",
          "type": "integer"
        },
        "maxWidth": {
          "maximum": 16384,
          "minimum": 1,
          "title": "Maxwidth",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "capabilities",
        "maxWidth",
        "maxHeight",
        "local"
      ],
      "title": "ProviderDescriptor",
      "type": "object"
    },
    "ProviderError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "missing_asset",
            "invalid_image",
            "unsupported_capability",
            "invalid_request",
            "authentication",
            "rate_limited",
            "timeout",
            "unavailable",
            "cancelled",
            "invalid_output"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProviderError",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/ProviderDescriptor"
    },
    "error": {
      "$ref": "#/$defs/ProviderError"
    },
    "generate": {
      "$ref": "#/$defs/GenerateRequest"
    },
    "inpaint": {
      "$ref": "#/$defs/InpaintRequest"
    },
    "result": {
      "$ref": "#/$defs/GenerationResult"
    }
  },
  "required": [
    "descriptor",
    "generate",
    "inpaint",
    "result",
    "error"
  ],
  "title": "ProviderContracts",
  "type": "object"
}
