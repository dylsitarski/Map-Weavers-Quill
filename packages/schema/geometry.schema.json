{
  "$defs": {
    "GeometryRequest": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Height",
          "type": "number"
        },
        "polygon": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 2048,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "polygon"
      ],
      "title": "GeometryRequest",
      "type": "object"
    },
    "GeometryResult": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "error"
      ],
      "title": "GeometryResult",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "request": {
      "$ref": "#/$defs/GeometryRequest"
    },
    "result": {
      "$ref": "#/$defs/GeometryResult"
    }
  },
  "required": [
    "request",
    "result"
  ],
  "title": "GeometryContracts",
  "type": "object"
}
