# No AI credentials are needed for Milestone 0.
# Development endpoints: 127.0.0.1:5173 (web), 127.0.0.1:8000 (API).

# Optional local project database directory (default: ./data).
# Export this variable before make dev; .env is not loaded automatically.
# MWQ_DATA_DIR=/path/to/quill-data

# Server-only image provider selection. Only mock is implemented; restart to change.
# MWQ_IMAGE_PROVIDER=mock
# Future hosted adapter credential sources (unused by mock). Set ONE only.
# Keep key files outside the repository and data directory; on Linux use chmod 600.
# MWQ_IMAGE_API_KEY_FILE=/absolute/private/path/image-api-key
# Alternatively export MWQ_IMAGE_API_KEY in the API environment.
# Never use a VITE_ variable for secrets. Do not put real values in this file.
