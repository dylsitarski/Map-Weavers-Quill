{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["apps/web", "packages", "tests/**/*.ts", "playwright.config.ts"]
}
