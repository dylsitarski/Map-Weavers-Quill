{
  "name": "map-weavers-quill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "types": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check",
    "lint": "biome check apps/web/src apps/web/vite.config.ts tests/*.test.ts tests/browser playwright.config.ts scripts/*.mjs",
    "test:browser": "playwright test",
    "preinstall": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "konva": "10.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
